# --- network exposure (loopback only unless you explicitly allow otherwise) ---
CLARIX_HOST=127.0.0.1
CLARIX_PORT=8000
# CLARIX_ALLOW_NON_LOOPBACK=1        # only if you accept exposing this on a LAN

# --- storage ---
CLARIX_DATA_DIR=./data

# --- local LLM (must be a loopback URL) ---
CLARIX_OLLAMA_URL=http://127.0.0.1:11434
CLARIX_DEFAULT_MODEL=qwen3:4b
CLARIX_EMBED_MODEL=nomic-embed-text
CLARIX_EMBED_BACKEND=auto           # auto | ollama | hash  (hash = lexical fallback, not semantic)

# --- auth: leave empty for single-user DEV MODE; set for anything shared ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CLARIX_API_TOKEN=
# CLARIX_OPERATOR_TOKENS=alice:<token>,bob:<token>   # identity comes from the token (recorded on approvals)

# --- browser origins allowed to call the API (the Vite dev/preview servers) ---
CLARIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- behaviour ---
CLARIX_APPROVAL_TIMEOUT_S=300
CLARIX_AIRGAP_ENFORCE=true          # in-process egress guard. Disable only for development.
CLARIX_DEMO_ENDPOINTS=true          # enables POST /api/approvals/simulate; set false in production
CLARIX_MAX_UPLOAD_MB=20
CLARIX_RATE_LIMIT_PER_MIN=60
CLARIX_TELEMETRY_INTERVAL_S=30

# --- Slack Integration (Incoming Webhooks & Isolated Relay) ---
# Disabled by default. Webhook secrets are kept strictly on the backend.
CLARIX_SLACK_ENABLED=false
CLARIX_SLACK_WEBHOOK_URL=
CLARIX_SLACK_CHANNEL=#security-alerts
# Outbound relay worker: must be explicitly authorized to deliver outside the air-gap
CLARIX_SLACK_RELAY_ENABLED=false
CLARIX_SLACK_RELAY_INTERVAL_S=3.0
