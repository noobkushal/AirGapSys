# Copy to .env.local. VITE_ variables are bundled into the page: never put real secrets here.
# Set to "false" once the FastAPI backend is running.
VITE_USE_MOCKS=true
VITE_API_URL=http://127.0.0.1:8000
VITE_OLLAMA_URL=http://localhost:11434
# Only if the backend has CLARIX_API_TOKEN set (loopback operator console). It is bundled into the page.
# VITE_API_TOKEN=
